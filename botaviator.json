javascript:(function(){
  if(document.getElementById("aviatorBotPanel")) return;

  // Painel base
  let panel = document.createElement("div");
  panel.id = "aviatorBotPanel";
  panel.style.cssText = `
    position:fixed;top:50px;left:50px;width:270px;z-index:999999;
    background:#111;color:#0f0;padding:10px;border-radius:10px;
    font-size:13px;font-family:monospace;
    box-shadow:0 0 10px #0f0;touch-action:none;
  `;
  panel.innerHTML = `
    <div style="font-weight:bold;text-align:center;margin-bottom:5px;">
      🎮 Aviator Bot Auto
    </div>
    <button id="mapearBtn">Mapear</button>
    <button id="estrategiaBtn">Estratégia</button>
    <button id="apagarLogs">Apagar Logs</button>
    <div id="logs" style="max-height:180px;overflow:auto;margin-top:5px;
      background:#000;color:#0f0;padding:5px;font-size:12px;">
      Logs iniciados...
    </div>
  `;
  document.body.appendChild(panel);

  let logs = document.getElementById("logs");
  function log(txt){
    logs.innerHTML += "<br>"+txt;
    logs.scrollTop = logs.scrollHeight;
  }

  // --- Funções do painel
  document.getElementById("apagarLogs").onclick = ()=> logs.innerHTML="";

  let mapeando = false;
  let elementos = {};
  document.getElementById("mapearBtn").onclick = ()=>{
    mapeando = true;
    log("👉 Clique em um elemento para mapear");
  };

  document.addEventListener("click",function(e){
    if(mapeando){
      e.preventDefault(); e.stopPropagation();
      let tipo = prompt("Esse elemento é o quê? (saldo, aposta1, aposta2, cashout, cor-verde, cor-vermelho, cor-azul)");
      if(tipo){
        elementos[tipo] = e.target;
        log("✅ Elemento '"+tipo+"' mapeado!");
      }
      mapeando = false;
    }
  },true);

  // --- Estratégias
  let estrategias = {}; // ex: { "verde": "aposta1", "vermelho": "cashout" }

  document.getElementById("estrategiaBtn").onclick = ()=>{
    let cor = prompt("Defina cor (verde, vermelho, azul):");
    if(!cor) return;
    let acao = prompt("O que fazer quando aparecer '"+cor+"'? (aposta1, aposta2, cashout)");
    if(acao){
      estrategias[cor] = acao;
      log("🎯 Estratégia: se cor '"+cor+"' → clicar '"+acao+"'");
    }
  };

  // --- Simulador automático de checagem de cores
  setInterval(()=>{
    for(let tipo in elementos){
      if(tipo.startsWith("cor-")){
        let cor = tipo.split("-")[1]; // ex: cor-verde -> verde
        let el = elementos[tipo];
        try{
          if(el && el.innerText.toLowerCase().includes(cor)){ 
            log("🎨 Cor detectada: "+cor);
            if(estrategias[cor]){
              let alvo = elementos[estrategias[cor]];
              if(alvo){
                alvo.click();
                log("🤖 Estratégia aplicada: clicou em '"+estrategias[cor]+"'");
              }
            }
          }
        }catch(err){}
      }
    }
  },2000); // a cada 2s verifica

  // --- Arrastar painel
  let offsetX, offsetY, isDown=false;
  panel.addEventListener("mousedown", e=>{
    isDown=true; offsetX=e.offsetX; offsetY=e.offsetY;
  });
  document.addEventListener("mousemove", e=>{
    if(isDown){
      panel.style.left = (e.pageX-offsetX)+"px";
      panel.style.top  = (e.pageY-offsetY)+"px";
    }
  });
  document.addEventListener("mouseup", ()=>isDown=false);

  // --- Mobile touch
  panel.addEventListener("touchstart", e=>{
    isDown=true;
    offsetX=e.touches[0].clientX - panel.offsetLeft;
    offsetY=e.touches[0].clientY - panel.offsetTop;
  });
  panel.addEventListener("touchmove", e=>{
    if(isDown){
      panel.style.left = (e.touches[0].clientX-offsetX)+"px";
      panel.style.top  = (e.touches[0].clientY-offsetY)+"px";
    }
  });
  panel.addEventListener("touchend", ()=>isDown=false);

  log("✅ Painel iniciado. Clique em MAPEAR para configurar.");
})();
